               .pack(side="left",padx=10)

        tvf = ctk.CTkFrame(self,fg_color="transparent")
        tvf.pack(fill="both",expand=True,padx=25,pady=8)
        self.tree = ttk.Treeview(tvf,columns=labels,show="headings")
        for c in labels:
            self.tree.heading(c,text=c)
            self.tree.column(c,width=180,anchor="center")
        self.tree.pack(fill="both",expand=True)
        self.tree.bind("<<TreeviewSelect>>",self.populate_form_from_tree)

    def force_upper(self, entry):
        v = entry.get().upper()
        entry.delete(0,"end"); entry.insert(0,v)

    def force_digits(self, entry):
        v = ''.join(filter(str.isdigit,entry.get()))
        entry.delete(0,"end"); entry.insert(0,v)

    def _validate_all(self):
        v=self.vars
        if not all(v[k].get().strip() for k in v):
            messagebox.showwarning("Validation","All fields required!"); return False
        if len(v["IFSC NO"].get())!=11:
            messagebox.showwarning("Validation","IFSC must be 11 chars."); return False
        if len(v["MICR NO"].get())!=9:
            messagebox.showwarning("Validation","MICR must be 9 digits."); return False
        return True

    def load_tree(self):
        self.tree.delete(*self.tree.get_children())
