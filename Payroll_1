    def generate_acquittance_roll(self):
        

        # ---------- styles ----------
        styles = {
            'wrap':   ParagraphStyle('wrap',   fontName='CourierNew', fontSize=9,  alignment=0, leading=12, wordWrap='CJK'),
            'header': ParagraphStyle('header', fontName='CourierNew', fontSize=15, alignment=1, leading=18, spaceAfter=12),
            'center': ParagraphStyle('center', fontName='CourierNew', fontSize=12, alignment=1, leading=14, spaceAfter=6),
            'left':   ParagraphStyle('left',   fontName='CourierNew', fontSize=11, alignment=0, leading=13, spaceAfter=2),
            'small':  ParagraphStyle('small',  fontName='CourierNew', fontSize=9,  alignment=1),
        }
        styles['center_bold'] = ParagraphStyle('center_bold', parent=styles['center'], fontName='Courier-Bold')
        styles['wrap_bold']   = ParagraphStyle('wrap_bold',   parent=styles['wrap'],   fontName='CourierNew-Bold')
        styles['left_bold']   = ParagraphStyle('left_bold',   parent=styles['left'],   fontName='CourierNew-Bold')

        # ---------- helpers ----------
        def fnum(x):
            try:
                return "{:,}".format(int(round(float(x or 0))))
            except Exception:
                return "0"

        month, year = get_report_month_year()

        # ---------- fetch rows (summary per employee for the month/year) ----------
        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT
                    COALESCE(e.pan_no, '') AS pan,
                    e.name,
                    e.ecs_no,
                    -- earnings for gross
                    earn.basic_pay, earn.da, earn.hra, earn.ta,
                    earn.da_arrears, earn.hra_arrears, earn.ta_arrears,
                    earn.fda, earn.ra, earn.sda, earn.others,
                    -- internal deductions for net pay
                    earn.cpf_emp, earn.saving_fund, earn.insurance_fund,
                    earn.hba, earn.mca, earn.income_tax
                FROM employee e
                JOIN earning earn
                ON e.ecs_no = earn.ecs_no
                AND earn.month = ?
                AND earn.year  = ?
                ORDER BY e.name
            """, (month, year)).fetchall()

            q_loans = """
                SELECT bank_name, branch_addr, loan_installment
                FROM loan_deductions
                WHERE ecs_no=? AND month=? AND year=?
                ORDER BY bank_name, branch_addr
            """
            q_lics = """
                SELECT lic_no, premium_amount
                FROM lic_premiums
                WHERE ecs_no=? AND month=? AND year=?
                ORDER BY lic_no
            """

            def fetch_third_party_lines(ecs_no):
                """Return list[(label, amount)] with banks (Bank - Branch) and LIC (LIC <no>)."""
                lines = []
                for bn, br, inst in con.execute(q_loans, (ecs_no, month, year)).fetchall():
                    label = f"{(bn or '').strip()} - {(br or '').strip()}".strip(" -")
                    try:
                        amt = float(inst or 0)
                    except:
                        amt = 0.0
                    lines.append((label, amt))
                for lic_no, prem in con.execute(q_lics, (ecs_no, month, year)).fetchall():
                    label = f"LIC {(lic_no or '').strip()}"
                    try:
                        amt = float(prem or 0)
                    except:
                        amt = 0.0
                    lines.append((label, amt))
                return lines

        if not rows:
            # Keep silent (open-first UX)
            return

        # ---------- document header ----------
        elements = []
        elements.append(Paragraph("Government of Goa", styles['header']))
        elements.append(Paragraph("ELECTRICITY", styles['center']))
        elements.append(Paragraph("EX. ENGR. ELECT DIVN. X, CURTI, PONDA", styles['center']))
        elements.append(Spacer(1, 3*mm))
        elements.append(Paragraph("ACQUITTANCE ROLL", styles['center_bold']))
        elements.append(Paragraph(f"Month: {month} . {year}", styles['left']))
        elements.append(Spacer(1, 2*mm))
        elements.append(Paragraph("Bill No : ____________", styles['left']))
        elements.append(Spacer(1, 4*mm))

        # ---------- table header ----------
        # Columns:
        # 0 PAN | 1 Name | 2 Gross | 3 Total Deduction (internal) | 4 Net | 5 ECS Code
        # 6 Bank/LIC | 7 Installment | 8 Total Third-Party | 9 ECS Pay
        table_data = [[
            Paragraph("PAN", styles['wrap']),
            Paragraph("Employee Name", styles['wrap']),
            Paragraph("Gross Pay", styles['wrap']),
            Paragraph("Total Deduction", styles['wrap']),   # internal
            Paragraph("Net Pay", styles['wrap']),
            Paragraph("ECS Code", styles['wrap']),
            Paragraph("Bank / LIC", styles['wrap']),
            Paragraph("Installment Amount", styles['wrap']),
            Paragraph("Total Third-Party Deduction", styles['wrap']),
            Paragraph("ECS Pay", styles['wrap']),
        ]]

        spans = []
        row_cursor = 1

        # grand totals
        gt_gross = gt_ded_int = gt_net = gt_third = gt_ecs = 0.0

        # ---------- rows per employee ----------
        for r in rows:
            (pan, emp_name, ecs_no,
            basic, da, hra, ta, da_arr, hra_arr, ta_arr, fda, ra, sda, others,
            cpf_emp, sav_fund, ins_fund, hba, mca, itax) = r

            earn_fields = [basic, da, hra, ta, da_arr, hra_arr, ta_arr, fda, ra, sda, others]
            try:
                gross = sum(float(x or 0) for x in earn_fields)
            except:
                gross = 0.0

            ded_internal_fields = [cpf_emp, sav_fund, ins_fund, hba, mca, itax]
            try:
                total_ded_internal = sum(float(x or 0) for x in ded_internal_fields)
            except:
                total_ded_internal = 0.0

            net_pre_third = gross - total_ded_internal

            dlines = fetch_third_party_lines(ecs_no)
            if not dlines:
                dlines = [("—", 0.0)]

            total_third = sum(a for _, a in dlines)
            ecs_pay = net_pre_third - total_third
            if ecs_pay < 0:
                ecs_pay = 0.0

            # accumulate grand totals (once per employee)
            gt_gross += gross
            gt_ded_int += total_ded_internal
            gt_net += net_pre_third
            gt_third += total_third
            gt_ecs += ecs_pay

            start_row = row_cursor
            for i, (label, amt) in enumerate(dlines):
                table_data.append([
                    Paragraph(pan or "", styles['wrap']) if i == 0 else "",
                    Paragraph(emp_name or "", styles['wrap']) if i == 0 else "",
                    Paragraph(fnum(gross), styles['wrap']) if i == 0 else "",
                    Paragraph(fnum(total_ded_internal), styles['wrap']) if i == 0 else "",
                    Paragraph(fnum(net_pre_third), styles['wrap']) if i == 0 else "",
                    Paragraph(ecs_no or "", styles['wrap']) if i == 0 else "",
                    Paragraph(label or "", styles['wrap']),
                    Paragraph(fnum(amt), styles['wrap']),
                    Paragraph(fnum(total_third), styles['wrap']) if i == 0 else "",
                    Paragraph(fnum(ecs_pay), styles['wrap']) if i == 0 else "",
                ])
                row_cursor += 1
            end_row = row_cursor - 1

            # span summary cols across the employee block
            for col in (0, 1, 2, 3, 4, 5, 8, 9):
                spans.append(('SPAN', (col, start_row), (col, end_row)))

        # ---------- totals row (bold) ----------
        totals_row = [
            Paragraph("TOTAL", styles['wrap_bold']),
            "",  # Name
            Paragraph(fnum(gt_gross), styles['wrap_bold']),
            Paragraph(fnum(gt_ded_int), styles['wrap_bold']),
            Paragraph(fnum(gt_net), styles['wrap_bold']),
            "",  # ECS Code
            "",  # Bank/LIC
            "",  # Installment
            Paragraph(fnum(gt_third), styles['wrap_bold']),
            Paragraph(fnum(gt_ecs), styles['wrap_bold']),
        ]
        table_data.append(totals_row)
        last_idx = len(table_data) - 1

        # ---------- layout & style ----------
        # Legal landscape usable width is larger; these widths (mm) fit comfortably.
        col_widths_mm = [20, 60, 20, 24, 22, 22, 85, 22, 26, 22]
        col_widths = [w * mm for w in col_widths_mm]

        t = Table(table_data, colWidths=col_widths, repeatRows=1)
        t.setStyle(TableStyle([
            ('FONTNAME', (0,0), (-1,-1), 'CourierNew'),
            ('FONTSIZE', (0,0), (-1,0), 10),
            ('FONTSIZE', (0,1), (-1,-1), 9),
            ('BACKGROUND', (0,0), (-1,0), colors.lightgrey),
            ('GRID', (0,0), (-1,-1), 0.5, colors.black),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),

            ('ALIGN', (0,0), (1,-1), 'LEFT'),     # PAN, Name
            ('ALIGN', (2,1), (5,-1), 'RIGHT'),    # Gross, Total Ded (internal), Net, ECS Code (centered below)
            ('ALIGN', (5,1), (5,-1), 'CENTER'),   # ECS Code centered
            ('ALIGN', (6,1), (6,-1), 'LEFT'),     # Bank/LIC
            ('ALIGN', (7,1), (9,-1), 'RIGHT'),    # Installment, Total Third-Party, ECS Pay

            # per-employee spans
        ] + spans + [
            # make the final totals row bold, with a line above
            ('FONTNAME', (0, last_idx), (-1, last_idx), 'CourierNew-Bold'),
            ('FONTSIZE', (0, last_idx), (-1, last_idx), 10),
            ('LINEABOVE', (0, last_idx), (-1, last_idx), 1.0, colors.black),
        ]))

        elements.append(t)
        elements.append(Spacer(1, 6*mm))

        # ---------- ECS Pay grand total in figure & words (both bold) ----------
        try:
            ecs_words = total_in_words(gt_ecs)  # e.g., RUPEES ... ONLY
        except Exception:
            from num2words import num2words
            ecs_words = num2words(int(round(gt_ecs)), lang='en_IN').upper() + " ONLY"

        elements.append(Paragraph(f"GRAND TOTAL ECS PAY (FIGURE): <b>₹ {fnum(gt_ecs)}</b>", styles['left']))
        elements.append(Paragraph(f"IN WORDS: <b>{ecs_words}</b>", styles['left']))
        elements.append(Spacer(1, 4*mm))
        elements.append(Paragraph("(This report is computer generated. No physical signature is required)", styles['small']))

        # ---------- page numbers ----------
        def add_page_number(c, doc):
            c.saveState()
            c.setFont('Courier', 10)
            # Legal landscape width ~ 355.6mm; right margin is 10mm -> print near 345mm
            c.drawRightString(345*mm, 10*mm, f"Page {doc.page}")
            c.restoreState()

        # ---------- write to temp (OPEN FIRST; no Save dialog) ----------
        tmp_path = os.path.join(tempfile.gettempdir(), f"Acquittance_Roll_{month}_{year}.pdf")
        doc = SimpleDocTemplate(
            tmp_path,
            pagesize=landscape(legal),
            topMargin=20*mm, bottomMargin=14*mm, leftMargin=10*mm, rightMargin=10*mm
        )
        doc.build(elements, onFirstPage=add_page_number, onLaterPages=add_page_number)

        self._last_pdf_path = tmp_path

        # open in default PDF viewer so user can save from there
        try:
            if sys.platform.startswith("win"):
                os.startfile(tmp_path)  # type: ignore[attr-defined]
            elif sys.platform == "darwin":
                subprocess.Popen(["open", tmp_path])
            else:
                subprocess.Popen(["xdg-open", tmp_path])
        except Exception:
            webbrowser.open_new("file://" + os.path.abspath(tmp_path))

    def generate_payslip_report(self):
       
        # ---------- styles ----------
        styles = {
            'h1':       ParagraphStyle('h1',       fontName='CourierNew-Bold', fontSize=13, leading=15, alignment=1, spaceAfter=4),
            'center':   ParagraphStyle('center',   fontName='CourierNew',      fontSize=11, leading=13, alignment=1, spaceAfter=1),
            'left':     ParagraphStyle('left',     fontName='CourierNew',      fontSize=11, leading=13, alignment=0, spaceAfter=1),
            'small':    ParagraphStyle('small',    fontName='CourierNew',      fontSize=9,  leading=11, alignment=0, spaceAfter=0),
            'small_r':  ParagraphStyle('small_r',  fontName='CourierNew',      fontSize=9,  leading=11, alignment=2, spaceAfter=0),
            'small_c':  ParagraphStyle('small_c',  fontName='CourierNew',      fontSize=9,  leading=11, alignment=1, spaceAfter=0),
            'dash':     ParagraphStyle('dash',     fontName='CourierNew',      fontSize=9,  leading=9,  alignment=0, spaceAfter=2),
            'bold':     ParagraphStyle('bold',     fontName='CourierNew-Bold', fontSize=10, leading=12, alignment=0, spaceAfter=0),
            'bold_r':   ParagraphStyle('bold_r',   fontName='CourierNew-Bold', fontSize=10, leading=12, alignment=2, spaceAfter=0),
        }
        styles['ecs'] = ParagraphStyle('ecs',fontName='CourierNew-Bold',fontSize=13,leading=16,alignment=1,spaceBefore=2,spaceAfter=2,)

        # ---------- helpers ----------
        def _open_pdf(path: str):
            try:
                if sys.platform.startswith("win"):
                    os.startfile(path)  # type: ignore[attr-defined]
                elif sys.platform == "darwin":
                    subprocess.Popen(["open", path])
                else:
                    subprocess.Popen(["xdg-open", path])
            except Exception:
                try:
                    webbrowser.open_new("file://" + os.path.abspath(path))
                except Exception:
                    pass

        try:
            fnum_fn = fnum
        except NameError:
            def fnum_fn(x):
                try:
                    return "{:,}".format(int(round(float(x or 0))))
                except Exception:
                    return "0"

        # Field order as per sample
        EARN_ORDER = [
            ("Basic Pay",  "basic_pay"),
            ("DA",         "da"),
            ("DA Arrears", "da_arrears"),
            ("HRA",        "hra"),
            ("HRA Arrears","hra_arrears"),
            ("TA",         "ta"),
            ("TA Arrears", "ta_arrears"),
            ("FDA",        "fda"),
            ("RA",         "ra"),
            ("SDA",        "sda"),
            ("Others",     "others"),
        ]
        DED_ORDER_INTERNAL = [
            ("CPF Emp(10%)",   "cpf_emp"),
            ("Insurance Fund", "insurance_fund"),
            ("Saving Fund",    "saving_fund"),
            ("Income Tax",     "income_tax"),
        ]
        # Third-party (computed): Bank Loan + LIC

        # ---------- month/year ----------
        month, year = get_report_month_year()

        # ---------- DB ----------
        with sqlite3.connect(DB_FILE) as con:
            con.row_factory = sqlite3.Row

            emp_rows = con.execute("""
                SELECT e.ecs_no, e.cpf_no, e.name, e.designation, e.sub_div, e.so
                FROM employee e
                JOIN earning earn
                ON e.ecs_no = earn.ecs_no
                AND earn.month = ?
                AND earn.year  = ?
                ORDER BY e.name
            """, (month, year)).fetchall()

            if not emp_rows:
                from tkinter import messagebox
                try:
                    messagebox.showwarning("No Data", f"No earnings found for {month} {year}.")
                finally:
                    return

            # ---- page geometry ----
            PAGE_W, PAGE_H = portrait(A4)
            LEFT_MARGIN, RIGHT_MARGIN, TOP_MARGIN, BOTTOM_MARGIN = 10*mm, 10*mm, 14*mm, 12*mm
            CONTENT_W = PAGE_W - LEFT_MARGIN - RIGHT_MARGIN

            # Build one "slip" block for a given employee
            def slip_block(emp_row):
                ecs_no = emp_row["ecs_no"]
                cpf_no = (emp_row["cpf_no"] or "").strip()
                name   = (emp_row["name"] or "").strip()
                desig  = (emp_row["designation"] or "").strip()
                subd   = (emp_row["sub_div"] or "").strip()
                so     = (emp_row["so"] or "").strip()

                earn = con.execute("""
                    SELECT * FROM earning WHERE ecs_no=? AND month=? AND year=?
                """, (ecs_no, month, year)).fetchone()
                earn = dict(earn) if earn else {}

                # Third-party sums
                loan_sum = con.execute(
                    "SELECT IFNULL(SUM(loan_installment),0) FROM loan_deductions WHERE ecs_no=? AND month=? AND year=?",
                    (ecs_no, month, year)
                ).fetchone()[0] or 0.0
                lic_sum = con.execute(
                    "SELECT IFNULL(SUM(premium_amount),0) FROM lic_premiums WHERE ecs_no=? AND month=? AND year=?",
                    (ecs_no, month, year)
                ).fetchone()[0] or 0.0

                # Earnings table (label, amount)
                earn_rows = []
                gross = 0.0
                for label, col in EARN_ORDER:
                    val = float(earn.get(col, 0) or 0)
                    gross += val
                    earn_rows.append([Paragraph(label, styles['small']), Paragraph(fnum_fn(val), styles['small_r'])])

                # Internal deductions
                ded_rows = []
                ded_internal = 0.0
                for label, col in DED_ORDER_INTERNAL:
                    val = float(earn.get(col, 0) or 0)
                    ded_internal += val
                    ded_rows.append([Paragraph(label, styles['small']), Paragraph(fnum_fn(val), styles['small_r'])])

                # Third-party breakdown rows (to show Bank Loan / LIC as separate lines)
                if loan_sum or True:  # always show the row even if 0 to match the sample layout
                    ded_rows.append([Paragraph("Bank Loan", styles['small']), Paragraph(fnum_fn(loan_sum), styles['small_r'])])
                if lic_sum or True:
                    ded_rows.append([Paragraph("LIC", styles['small']), Paragraph(fnum_fn(lic_sum), styles['small_r'])])

                third_party = float(loan_sum) + float(lic_sum)
                total_deduction = ded_internal + third_party
                ecs_pay = gross - total_deduction

                # ---- header block (centered) ----
                block = []
                block.append(Paragraph("Government of Goa", styles['center']))
                block.append(Paragraph("ELECTRICITY DEPARTMENT", styles['center']))
                block.append(Paragraph(" EX. ENGR. ELECT DIVN. X, CURTI, PONDA", styles['center']))
                block.append(Paragraph("Pay Slip (WORKCHARGED)", styles['h1']))

                # Top line: Bill No. | Month | Category
                BILL_NO = ""  # put the real one here if you have it
                category_text = ""
                if subd or so:
                    # matches the feel of the sample text
                    category_text = f"Category : {subd}, {so} - NPS  - (Work charged)".replace("  ", " ").strip()

                line_top = Table(
                    [[
                        Paragraph(f"Bill No.: {BILL_NO or ''}", styles['small']),
                        Paragraph(f"Month: {month}", styles['small_c']),
                        Paragraph(category_text, styles['small_r'])
                    ]],
                    colWidths=[CONTENT_W*0.22, CONTENT_W*0.22, CONTENT_W*0.56]
                )
                line_top.setStyle(TableStyle([
                    ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 0),
                ]))
                block.append(line_top)

                # Next line: CPF/NPS; then Name / Designation
                line_mid1 = Table(
                    [[Paragraph(f"CPF/NPS A/C No.: {cpf_no}", styles['small'])]],
                    colWidths=[CONTENT_W]
                )
                line_mid1.setStyle(TableStyle([('BOTTOMPADDING', (0,0), (-1,-1), 0)]))
                block.append(line_mid1)

                line_mid2 = Table(
                    [[
                        Paragraph(f"Name : {name}", styles['small']),
                        Paragraph(f"Designation : {desig}", styles['small_r']),
                    ]],
                    colWidths=[CONTENT_W*0.55, CONTENT_W*0.45]
                )
                line_mid2.setStyle(TableStyle([
                    ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 0),
                ]))
                block.append(line_mid2)

                # dashed rule
                block.append(Paragraph("-"*97, styles['dash']))

                # two-column table (earnings left, deductions right)
                earn_tbl = Table(earn_rows, colWidths=[60*mm, 24*mm])
                earn_tbl.setStyle(TableStyle([
                    ('ALIGN', (1,0), (1,-1), 'RIGHT'),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 1),
                ]))

                ded_tbl = Table(ded_rows, colWidths=[60*mm, 24*mm])
                ded_tbl.setStyle(TableStyle([
                    ('ALIGN', (1,0), (1,-1), 'RIGHT'),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 1),
                ]))

                two_col = Table([[earn_tbl, ded_tbl]], colWidths=[(CONTENT_W-6*mm)/2, (CONTENT_W-6*mm)/2])
                two_col.setStyle(TableStyle([
                    ('VALIGN', (0,0), (-1,-1), 'TOP'),
                    ('LEFTPADDING', (0,0), (-1,-1), 0),
                    ('RIGHTPADDING',(0,0), (-1,-1), 0),
                ]))
                block.append(two_col)

                # dashed rule
                block.append(Paragraph("-"*97, styles['dash']))

                # Totals line in ONE row, with number right after the label
                totals_tbl = Table([[
                    Paragraph(f"Gross Pay: {fnum_fn(gross)}", styles['bold']),
                    Paragraph(f"Deduction: {fnum_fn(total_deduction)}", styles['bold']),
                    Paragraph(f"Third Party Ded.: {fnum_fn(third_party)}", styles['bold']),
                ]], colWidths=[CONTENT_W*0.33, CONTENT_W*0.33, CONTENT_W*0.34])

                totals_tbl.setStyle(TableStyle([
                    ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
                    ('ALIGN', (0,0), (-1,-1), 'LEFT'),
                    ('LEFTPADDING', (0,0), (-1,-1), 2),
                    ('RIGHTPADDING', (0,0), (-1,-1), 2),
                    ('TOPPADDING', (0,0), (-1,-1), 0),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 0),
                ]))
                block.append(totals_tbl)

                # ECS line + disclaimer
                block.append(Spacer(1, 1*mm))
                block.append(Paragraph(f"ECS Pay: {fnum_fn(ecs_pay)}", styles['ecs']))

                block.append(Paragraph(
                    "This salary slip is issued for information of the incumbent and is not for obtaining bank loan "
                    "or to stand surety for any purpose.(Slip is computer generated and doesn't require sig.)",
                    styles['small']
                ))

                # Keep a little breathing room below each slip
                block.append(Spacer(1, 2*mm))

                return KeepTogether(block)

            # ---- assemble document: TWO slips per page ----
            tmp_path = os.path.join(tempfile.gettempdir(), f"Pay_Slips_2up_{month}_{year}.pdf")
            doc = SimpleDocTemplate(
                tmp_path,
                pagesize=portrait(A4),
                leftMargin=LEFT_MARGIN, rightMargin=RIGHT_MARGIN,
                topMargin=TOP_MARGIN, bottomMargin=BOTTOM_MARGIN
            )

            elements = []
            # pack two slips per page; insert PageBreak after every pair
            for idx, emp in enumerate(emp_rows, start=1):
                elements.append(slip_block(emp))
                if idx % 2 == 0 and idx != len(emp_rows):
                    elements.append(PageBreak())

            # page numbers
            def add_page_number(c, doc_):
                c.saveState()
                c.setFont('Courier', 9)
                c.drawRightString(PAGE_W - RIGHT_MARGIN, 8*mm, f"Page {doc_.page}")
                c.restoreState()

            doc.build(elements, onFirstPage=add_page_number, onLaterPages=add_page_number)

            self._last_pdf_path = tmp_path
            _open_pdf(tmp_path)

    
