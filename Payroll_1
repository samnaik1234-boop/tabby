        self.controller = controller

        self.kpi = {
            "month_year": ctk.StringVar(value=""),
            "total_employees": ctk.StringVar(value="0"),
            "active_employees": ctk.StringVar(value="0"),
            "gross": ctk.StringVar(value="0"),
            "deductions": ctk.StringVar(value="0"),
            "thirdparty": ctk.StringVar(value="0"),
            "net": ctk.StringVar(value="0"),
            "ecs": ctk.StringVar(value="0"),
        }

        self._chart_canvas = None
        self._chart_area   = None
        self._chart_title  = ctk.StringVar(value="")

        self._build()
        self.refresh()

    # ---------- small helpers ----------
    def _kpi_card(self, parent, title, varkey, row, col, color, hint=""):
        card = ctk.CTkFrame(parent, corner_radius=18, fg_color=color)
        card.grid(row=row, column=col, sticky="nsew", padx=10, pady=10)
        card.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(card, text=title, anchor="w",
                     font=("Segoe UI", 12, "bold"), text_color="#FFFFFF")\
            .grid(row=0, column=0, sticky="ew", padx=14, pady=(12, 0))

        ctk.CTkLabel(card, textvariable=self.kpi[varkey], anchor="w",
                     font=("Segoe UI", 28, "bold"), text_color="#FFFFFF")\
            .grid(row=1, column=0, sticky="ew", padx=14, pady=(2, 10))

        if hint:
            ctk.CTkLabel(card, text=hint, anchor="w",
                         font=("Segoe UI", 10), text_color="#E5E7EB")\
              .grid(row=2, column=0, sticky="ew", padx=14, pady=(0, 12))
        return card

    @staticmethod
    def _fnum(x):
        try:
            return "{:,}".format(int(round(float(x or 0))))
        except Exception:
            return "0"

