        for c in cols:
            self.tree.heading(c,text=c); self.tree.column(c,width=110,anchor="center")
        self.tree.pack(fill="both",expand=True)
        self.tree.tag_configure('oddrow',background='#f0f0f0')
        self.tree.tag_configure('evenrow',background='white')
        self.tree.bind("<<TreeviewSelect>>",self.populate_form_from_tree)
        self.load_tree_from_db()

    def refresh_subdiv_so(self):
            # 1) Re-load the up-to-date lists from the controller
            subdivs = self.controller.load_subdivisions()
            so_list = self.controller.load_sectionoffices()
            # 2) Update the SUB-DIV menu
            menu = self.entries["SUB-DIV"]
            menu.configure(values=subdivs or [""])
            if subdivs:
                menu.set(subdivs[0])
            # 3) Update the SECTION OFFICE menu
            so_menu = self.entries["SECTION OFFICE"]
            so_menu.configure(values=so_list or [""])
            if so_list:
                so_menu.set(so_list[0])

    def load_tree_from_db(self):
        self.tree.delete(*self.tree.get_children())
        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT ecs_no,name,address,doj,cpf_no,pan_no,
                    mobile_no,designation,qualification,dob,retirement,
                    level,basic_pay,phys_challenged,pran_no,sub_div,so
                FROM employee
            """).fetchall()

        for row in rows:
            tag = "evenrow" if len(self.tree.get_children())%2==0 else "oddrow"
            self.tree.insert("", "end", values=row, tags=(tag,))

    def save_form(self):
        if not self._validate_all(): return
        E = self.entries
        vals = [E[k].get().strip().upper() for k in [
                "ECS NO","NAME","ADDRESS","DATE OF JOINING",
                "CPF NO","PAN NO","MOBILE NO","DESIGNATION","QUALIFICATION",
                "DATE OF BIRTH","DATE OF RETIREMENT",
                "LEVEL","BASIC PAY","PHYSICALLY CHALLENGED",
                "PRAN NO","SUB-DIV","SECTION OFFICE"
            ]]

        with sqlite3.connect(DB_FILE) as con:
            try:
                con.execute("""
                            INSERT INTO employee
                            (ecs_no,name,address,doj,cpf_no,pan_no,
                            mobile_no,designation,qualification,dob,retirement,
                            level,basic_pay,phys_challenged,pran_no,sub_div,so)
                            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                        """, vals)

            except sqlite3.IntegrityError:
                return messagebox.showerror("Duplicate","This ECS NO exists.")
        messagebox.showinfo("Success","Staff details saved.")
        self.load_tree_from_db(); self.clear_form()

    def update_form(self):
        sel = self.tree.selection()
        if not sel: return messagebox.showwarning("Select","Pick row to update.")
        if not self._validate_all(): return
        old_ecs = self.tree.item(sel[0])['values'][0]
        E = self.entries
        vals = [E[k].get().strip().upper() for k in [
                "NAME","ADDRESS","DATE OF JOINING","CPF NO","PAN NO",
                "MOBILE NO","DESIGNATION","QUALIFICATION","DATE OF BIRTH","DATE OF RETIREMENT",
                "LEVEL","BASIC PAY","PHYSICALLY CHALLENGED","PRAN NO",
                "SUB-DIV","SECTION OFFICE"
            ]]

        with sqlite3.connect(DB_FILE) as con:
            con.execute(f"""
                    UPDATE employee SET
                    name=?,address=?,doj=?,cpf_no=?,pan_no=?,
                    mobile_no=?,designation=?,qualification=?,dob=?,retirement=?,
                    level=?,basic_pay=?,phys_challenged=?,
                    pran_no=?,sub_div=?,so=?
                    WHERE ecs_no=?
                """, vals+[old_ecs])

        messagebox.showinfo("Updated","Record updated.")
        self.load_tree_from_db(); self.clear_form()

    def delete_form(self):
        sel = self.tree.selection()
        if not sel: return messagebox.showwarning("Select","Pick row to delete.")
        ecs_no = self.tree.item(sel[0])['values'][0]
        with sqlite3.connect(DB_FILE) as con:
            con.execute("DELETE FROM employee WHERE ecs_no=?", (ecs_no,))
        messagebox.showinfo("Deleted","Record deleted.")
        self.load_tree_from_db(); self.clear_form()

    def clear_form(self):
        for key, widget in self.entries.items():
            # — Date pickers → reset to today
            if isinstance(widget, DateEntry):
                widget.set_date(date.today())
                if key == "DATE OF BIRTH":
                    # update retirement date field when dob resets
                    self._update_retirement_date()


            # — Option menus → set back to your defaults
            elif isinstance(widget, ctk.CTkOptionMenu):
                if key == "PHYSICALLY CHALLENGED":
                    widget.set("NO")
                elif key == "SUB-DIV":
                    widget.set(self.controller.sub_division_list[0] if self.controller.sub_division_list else "")
                elif key == "SECTION OFFICE":
                    widget.set(self.controller.section_office_list[0] if self.controller.section_office_list else "")

            # — Everything else (CTkEntry) → clear text
            else:
                # make sure retirement is temporarily editable so we can delete its contents
                widget.configure(state="normal")
                widget.delete(0, "end")
                # and if it was the retirement field, lock it back down
                if key == "DATE OF RETIREMENT":
                    widget.configure(state="readonly")

    
    def populate_form_from_tree(self, _=None):
        sel = self.tree.selection()
        if not sel: return
        vals = self.tree.item(sel[0])['values']
        keys = list(self.entries.keys())
        for k,v in zip(keys, vals):
            e = self.entries[k]
            if isinstance(e, DateEntry):
                try:
                    d = datetime.strptime(v, "%d/%m/%Y").date()
                    e.set_date(date.today())
                except:
                    e.set_date(date.today())
                if k == "DATE OF BIRTH":
                    self._update_retirement_date()
            elif isinstance(e, ctk.CTkOptionMenu):
                e.set(v)
            else:
                e.delete(0,"end"); e.insert(0,v)



