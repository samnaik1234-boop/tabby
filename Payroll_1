    def clear_form(self):
        for var in (self.month_var,self.year_var,self.da_var,
                    self.hra_var,self.ta_var,self.tah_var):
            var.set("")
        self.tree.selection_remove(self.tree.selection())

    def load_tree(self):
        self.tree.delete(*self.tree.get_children())
        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT month,year,da,hra,ta,tah
                FROM da_hra_ta
                ORDER BY year DESC, month DESC
            """).fetchall()
        for r in rows:
            tag = "evenrow" if len(self.tree.get_children())%2==0 else "oddrow"
            self.tree.insert("", "end", values=r, tags=(tag,))

    def add_row(self):
        m,y,da,hr,ta,th = (
          self.month_var.get().strip().upper(),
          self.year_var.get().strip(),
          self.da_var.get().strip(),
          self.hra_var.get().strip(),
          self.ta_var.get().strip(),
          self.tah_var.get().strip()
        )
        if not all((m,y,da,hr,ta,th)):
            return messagebox.showwarning("Validation","Fill all fields.")
        try:
            y_i,da_f,hr_f,ta_f,th_f = int(y),float(da),float(hr),float(ta),float(th)
        except:
            return messagebox.showerror("Invalid","Year/DA/HRA/TA/TAH numeric!")
        with sqlite3.connect(DB_FILE) as con:
            if con.execute("SELECT 1 FROM da_hra_ta WHERE month=? AND year=?", (m,y)).fetchone():
                return messagebox.showwarning("Duplicate","Exists already.")
            con.execute("""
                INSERT INTO da_hra_ta(month,year,da,hra,ta,tah)
                VALUES(?,?,?,?,?,?)
            """,(m,y,da_f,hr_f,ta_f,th_f))
        messagebox.showinfo("Success","Entry added.")
        self.load_tree(); self.clear_form()

    def update_row(self):
        sel = self.tree.selection()
        if not sel: return messagebox.showwarning("Select","Pick a row.")
        old = self.tree.item(sel[0])['values'][:2]
        m,y,da,hr,ta,th = (
          self.month_var.get().strip().upper(),
          self.year_var.get().strip(),
          self.da_var.get().strip(),
          self.hra_var.get().strip(),
          self.ta_var.get().strip(),
          self.tah_var.get().strip()
        )
        if not all((m,y,da,hr,ta,th)):
            return messagebox.showwarning("Validation","Fill all fields.")
        try:
            float(da); float(hr); float(ta); float(th); int(y)
        except:
            return messagebox.showerror("Invalid","Numeric required.")
        with sqlite3.connect(DB_FILE) as con:
            con.execute("""
                UPDATE da_hra_ta
                SET month=?,year=?,da=?,hra=?,ta=?,tah=?
                WHERE month=? AND year=?
            """,(m,y,da,hr,ta,th,old[0],old[1]))
        messagebox.showinfo("Updated","Entry updated.")
        self.load_tree(); self.clear_form()

    def delete_row(self):
        sel=self.tree.selection()
        if not sel: return messagebox.showwarning("Select","Pick a row.")
        old=self.tree.item(sel[0])['values'][:2]
        with sqlite3.connect(DB_FILE) as con:
            con.execute("DELETE FROM da_hra_ta WHERE month=? AND year=?",
                        (old[0],old[1]))
        messagebox.showinfo("Deleted","Entry deleted.")
        self.load_tree(); self.clear_form()

    def _force_digits_or_decimal(self, event):
        entry = event.widget
        val = entry.get()                # grab the new text
        new_val = re.sub(r"[^0-9.]", "", val)
        if val != new_val:
            entry.delete(0, "end")
            entry.insert(0, new_val)


    def populate_form_from_tree(self,_=None):
        sel=self.tree.selection()
        if not sel: return
        v=self.tree.item(sel[0])['values']
        self.month_var.set(v[0]); self.year_var.set(v[1])
        self.da_var.set(str(v[2])); self.hra_var.set(str(v[3]))
        self.ta_var.set(str(v[4])); self.tah_var.set(str(v[5]))

