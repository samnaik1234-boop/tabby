        self.tree.tag_configure('evenrow', background='white')
        self.tree.bind("<<TreeviewSelect>>", self.on_select)

    def _validate(self):
        for k, v in self.vars.items():
            if not v.get().strip():
                messagebox.showwarning("Validation", f"Please enter {k}.")
                return False
        return True

    def _key_tuple(self):
        return (
            self.vars["MAJOR HEAD"].get().strip(),
            self.vars["SUB MAJOR HEAD"].get().strip(),
            self.vars["MINOR HEAD"].get().strip(),
            self.vars["SUB HEAD"].get().strip(),
        )

    def load_tree(self):
        self.tree.delete(*self.tree.get_children())
        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT major_head, sub_major_head, minor_head, sub_head
                FROM head_of_account
                ORDER BY major_head, sub_major_head, minor_head, sub_head
            """).fetchall()
        for r in rows:
            tag = "evenrow" if len(self.tree.get_children()) % 2 == 0 else "oddrow"
            self.tree.insert("", "end", values=r, tags=(tag,))

    def save(self):
        if not self._validate(): return
        key = self._key_tuple()
        with sqlite3.connect(DB_FILE) as con:
            try:
                con.execute("""
                    INSERT INTO head_of_account
                    (major_head, sub_major_head, minor_head, sub_head)
                    VALUES (?, ?, ?, ?)
                """, key)
            except sqlite3.IntegrityError:
                messagebox.showerror("Duplicate", "This Head of Account already exists.")
                return
        messagebox.showinfo("Saved", "Head of Account saved.")
        self.load_tree(); self.clear()

    def update(self):
        if not self._old_key:
            messagebox.showwarning("Select", "Pick a row to update from the table.")
            return
        if not self._validate(): return
        new_key = self._key_tuple()
        with sqlite3.connect(DB_FILE) as con:
            # If key changed, ensure it doesn't collide
            if new_key != self._old_key:
                exists = con.execute("""
                    SELECT 1 FROM head_of_account
                    WHERE major_head=? AND sub_major_head=? AND minor_head=? AND sub_head=?
                """, new_key).fetchone()
                if exists:
                    messagebox.showwarning("Duplicate", "Another record with same values exists.")
                    return
            con.execute("""
                UPDATE head_of_account
                SET major_head=?, sub_major_head=?, minor_head=?, sub_head=?
                WHERE major_head=? AND sub_major_head=? AND minor_head=? AND sub_head=?
            """, (*new_key, *self._old_key))
        messagebox.showinfo("Updated", "Record updated.")
        self.load_tree(); self.clear()

    def delete(self):
        if not self._old_key:
            messagebox.showwarning("Select", "Pick a row to delete.")
            return
        with sqlite3.connect(DB_FILE) as con:
            con.execute("""
                DELETE FROM head_of_account
                WHERE major_head=? AND sub_major_head=? AND minor_head=? AND sub_head=?
            """, self._old_key)
        messagebox.showinfo("Deleted", "Record deleted.")
        self.load_tree(); self.clear()

    def clear(self):
        for v in self.vars.values(): v.set("")
        self._old_key = None
        self.tree.selection_remove(self.tree.selection())

    def on_select(self, _=None):
        sel = self.tree.selection()
        if not sel: return
        vals = self.tree.item(sel[0])['values']
        keys = list(self.vars.keys())
        for k, v in zip(keys, vals):
            self.vars[k].set(v)
        self._old_key = tuple(vals)



