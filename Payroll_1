            elif lbl in ("MICR NO", "ACCOUNT NO"):
                vcmd = (self.register(self._only_digits), '%P')
                ent.configure(validate="key", validatecommand=vcmd)
                

        btns = ctk.CTkFrame(self,fg_color="transparent")
        btns.pack(fill="x",padx=25,pady=6)
        for txt,cmd in [("SAVE",self.save_form),
                        ("UPDATE",self.update_form),
                        ("DELETE",self.delete_form),
                        ("CLEAR",self.clear_form)]:
