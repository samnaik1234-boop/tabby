    def search_tree(self):
            """Search and display earnings for the given ECS No in the tree."""
            ecs = self.search_var.get().strip().upper()
            if not ecs:
                messagebox.showwarning("Input", "Enter an ECS No. to search.")
                return
            self.tree.delete(*self.tree.get_children())
            with sqlite3.connect(DB_FILE) as con:
                rows = con.execute("""
                    SELECT
                        ecs_no, month, year, name, designation, basic_pay,
                        da, hra, ta, da_arrears, hra_arrears, ta_arrears,
                        fda, ra, sda, others,
                        cpf_emp, cpf_govt, saving_fund, insurance_fund,
                        hba, mca, income_tax,
                        0, 0
                    FROM earning
                    WHERE ecs_no=?
                    ORDER BY year DESC, month DESC
                """, (ecs,)).fetchall()
                for r in rows:
                    mon, yr = r[1], r[2]
                    lic_sum = con.execute(
                        "SELECT IFNULL(SUM(premium_amount),0) FROM lic_premiums WHERE ecs_no=? AND month=? AND year=?",
                        (ecs, mon, yr)
                    ).fetchone()[0]
                    loan_sum = con.execute(
                        "SELECT IFNULL(SUM(loan_installment),0) FROM loan_deductions WHERE ecs_no=? AND month=? AND year=?",
                        (ecs, mon, yr)
                    ).fetchone()[0]
                    row_display = list(r[:-2]) + [lic_sum, loan_sum]
                    self.tree.insert("", "end", values=row_display)

