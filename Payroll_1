def get_active_month_year():
    with sqlite3.connect(DB_FILE) as con:
        cur = con.cursor()
        cur.execute("SELECT value FROM app_settings WHERE key='active_month'")
        month = (cur.fetchone() or [""])[0]
        cur.execute("SELECT value FROM app_settings WHERE key='active_year'")
        year = (cur.fetchone() or [""])[0]
    return month, year

def get_report_month_year():
    month, year = get_active_month_year()
    if not month or not year:
        # fallback to system date only if DB has no setting
        now = datetime.now()
        return now.strftime("%B").upper(), now.strftime("%Y")
    return month, year



def format_currency(val):
    try:
        return "₹{:,.0f}".format(float(val))
    except Exception:
        return str(val)

def total_in_words(val):
    try:
        return num2words(int(val), lang='en_IN').upper() + " ONLY"
    except Exception:
        return ""

# --- DB STRUCTURE: create if not exists & add phys_challenged if not present ---
def setup_db():
    with sqlite3.connect(DB_FILE) as con:
        con.execute("""
            CREATE TABLE IF NOT EXISTS employee (
                ecs_no TEXT PRIMARY KEY,
                name TEXT, address TEXT, doj TEXT, cpf_no TEXT, pan_no TEXT,
                mobile_no TEXT, designation TEXT, dob TEXT, retirement TEXT,
                level TEXT, basic_pay TEXT, pc TEXT, pran_no TEXT, sub_div TEXT,
                so TEXT, phys_challenged TEXT, qualification TEXT
            )
        """)
    with sqlite3.connect(DB_FILE) as con:
        con.execute("""
            CREATE TABLE IF NOT EXISTS head_of_account (
                major_head TEXT,
                sub_major_head TEXT,
                minor_head TEXT,
                sub_head TEXT,
                PRIMARY KEY (major_head, sub_major_head, minor_head, sub_head)
            )
        """)


        con.execute("""
            CREATE TABLE IF NOT EXISTS da_hra_ta (
                month TEXT, year TEXT, da REAL, hra REAL, ta REAL,
                tah REAL,
                PRIMARY KEY (month, year)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS bank (
                bank_name TEXT, branch_addr TEXT,
                micr TEXT, ifsc TEXT, account_no TEXT,
                PRIMARY KEY (bank_name, branch_addr)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS subdiv_so (
                subdiv TEXT, soffice TEXT,
                PRIMARY KEY (subdiv, soffice)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS loan_deductions (
                ecs_no TEXT, month TEXT, year TEXT,
                bank_name TEXT, branch_addr TEXT,
                loan_amount REAL, loan_installment REAL,
                PRIMARY KEY (ecs_no, month, year, bank_name, branch_addr)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS lic_premiums (
                ecs_no TEXT, month TEXT, year TEXT,
                lic_no TEXT, premium_amount REAL,
                PRIMARY KEY (ecs_no, month, year, lic_no)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS earning (
                ecs_no TEXT, month TEXT, year TEXT,
                name TEXT, designation TEXT, basic_pay REAL,
                da REAL, hra REAL, ta REAL,
                da_arrears REAL, hra_arrears REAL, ta_arrears REAL,
                fda REAL, ra REAL, sda REAL, others REAL,
                cpf_emp REAL, cpf_govt REAL, saving_fund REAL,
                insurance_fund REAL, hba REAL, mca REAL,
                income_tax REAL,
                PRIMARY KEY (ecs_no, month, year)
            )
        """)
        con.execute("""
            CREATE TABLE IF NOT EXISTS designation_master (
                designation TEXT PRIMARY KEY
            )
        """)


        existing = [c[1] for c in con.execute("PRAGMA table_info(earning)").fetchall()]
        for col in ("lic","loan"):
            if col not in existing:
                con.execute(f"ALTER TABLE earning ADD COLUMN {col} REAL DEFAULT 0")


        # add phys_challenged to employee if missing
        cols = [c[1] for c in con.execute("PRAGMA table_info(employee)").fetchall()]
        if "phys_challenged" not in cols:
            con.execute("ALTER TABLE employee ADD COLUMN phys_challenged TEXT")

        cols = [c[1] for c in con.execute("PRAGMA table_info(employee)").fetchall()]
        if "qualification" not in cols:
            con.execute("ALTER TABLE employee ADD COLUMN qualification TEXT")


setup_db()


def fetch_employee_by_ecs(ecs_no):
    with sqlite3.connect(DB_FILE) as con:
        row = con.execute("SELECT * FROM employee WHERE ecs_no=?", (ecs_no,)).fetchone()
    if not row: return None
    keys = ["ecs_no","name","address","doj","cpf_no","pan_no","mobile_no","designation",
        "dob","retirement","level","basic_pay","pc","pran_no","sub_div","so",
        "phys_challenged","qualification"]

    return dict(zip(keys, row))


def init_app_settings():
    with sqlite3.connect("salary_manager.db") as con:
        con.execute("""
            CREATE TABLE IF NOT EXISTS app_settings (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        """)
        # Optionally set default month/year if not present
        for k, v in [("active_month", "APRIL"), ("active_year", "2025")]:
            cur = con.execute("SELECT value FROM app_settings WHERE key=?", (k,))
            if cur.fetchone() is None:
                con.execute("INSERT INTO app_settings (key, value) VALUES (?, ?)", (k, v))


