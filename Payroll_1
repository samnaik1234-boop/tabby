class ReportTabFrame(ctk.CTkFrame):
    """Professional, visually-appealing TabView for all staff salary reports."""

    def _temp_pdf_path(self, base_name="Report"):
        month, year = get_report_month_year()
        fname = f"{base_name}_{month}_{year}.pdf"
        return os.path.join(tempfile.gettempdir(), fname)
    
    def _fit_wrap(self, label: ctk.CTkLabel, pad: int = 28):
        """Dynamically set wraplength to the current widget width minus padding."""
        def _on_cfg(e):
            label.configure(wraplength=max(120, e.width - pad))
        label.bind("<Configure>", _on_cfg)


    def _open_file(self, path):
        try:
            if sys.platform.startswith("win"):
                os.startfile(path)               # Windows
            elif sys.platform == "darwin":
                subprocess.Popen(["open", path]) # macOS
            else:
                subprocess.Popen(["xdg-open", path]) # Linux
        except Exception:
            webbrowser.open_new("file://" + os.path.abspath(path))

    def _remember(self, path):
        self._last_pdf_path = path


    def __init__(self, master, controller=None):
        super().__init__(master)
        self.controller = controller
        self._build()

    def _build(self):
        self.tabview = ctk.CTkTabview(self)
        self.tabview.pack(fill="both", expand=True, padx=24, pady=24)

        # Add tabs with clear titles
        self.tabview.add("Earning")
        self.tabview.add("Deduction")
        self.tabview.add("Other Reports")

        # Attach the sections only once
        self._add_earning_tab(self.tabview.tab("Earning"))
        self._add_deduction_tab(self.tabview.tab("Deduction"))
        self._add_other_reports_tab(self.tabview.tab("Other Reports"))

    def _add_earning_tab(self, parent):
        # === Scrollable container so nothing spills even on small windows ===
        container = ctk.CTkScrollableFrame(parent, fg_color="transparent")
        container.pack(fill="both", expand=True, padx=12, pady=12)
        container.grid_columnconfigure((0, 1), weight=1, uniform="col")

        # ---------- header ----------
        month, year = get_report_month_year()

        header = ctk.CTkFrame(container, fg_color="transparent")
        header.grid(row=0, column=0, columnspan=2, sticky="ew", padx=12, pady=(6, 0))
        header.grid_columnconfigure(0, weight=1)

        title = ctk.CTkLabel(
            header, text="Reports — Earning Suite",
            font=("Segoe UI", 20, "bold"), anchor="w"
        )
        title.grid(row=0, column=0, sticky="w")

        pill = ctk.CTkFrame(header, corner_radius=9999, fg_color="#EEF2FF")
        pill.grid(row=0, column=1, sticky="e", padx=6)
        ctk.CTkLabel(
            pill, text=f"{month} {year}",
            font=("Segoe UI", 12, "bold"), text_color="#1E40AF"
        ).pack(padx=10, pady=4)

        hint = ctk.CTkLabel(
            container,
            text="Preview opens first; use your PDF viewer’s “Save As” to export.",
            font=("Segoe UI", 11), text_color="#6B7280", anchor="w", justify="left"
        )
        hint.grid(row=1, column=0, columnspan=2, sticky="we", padx=16, pady=(2, 8))
        self._fit_wrap(hint)

        # ---------- card factory ----------
        def primary_btn(master, text, cmd):
            return ctk.CTkButton(
                master, text=text, height=36, corner_radius=12,
                font=("Segoe UI", 13, "bold"),
                fg_color="#2563EB", hover_color="#1E40AF",
                command=cmd,
            )

        def make_card(r, c, emoji, title, desc, action_text, action_cmd):
            card = ctk.CTkFrame(
                container,
                corner_radius=16, border_width=1, border_color="#E5E7EB",
                fg_color="white",
            )
            card.grid(row=r, column=c, sticky="nsew", padx=12, pady=12)
            card.grid_columnconfigure(0, weight=1)

            ctk.CTkLabel(
                card, text=f"{emoji}  {title}",
                font=("Segoe UI", 15, "bold"), anchor="w"
            ).grid(row=0, column=0, sticky="w", padx=14, pady=(14, 6))

            desc_lbl = ctk.CTkLabel(
                card, text=desc,
                font=("Segoe UI", 12), text_color="#6B7280",
                anchor="w", justify="left"
            )
            desc_lbl.grid(row=1, column=0, sticky="we", padx=14, pady=(0, 10))
            self._fit_wrap(desc_lbl)  # force description to wrap inside the card

            btn_row = ctk.CTkFrame(card, fg_color="transparent")
