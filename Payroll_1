    # ---------- data ----------
    def refresh(self):
        month, year = get_active_month_year()
        self.kpi["month_year"].set(f"{month} {year}")
        self._chart_title.set(f"Pay-wise Earnings Split — {month} {year}")

        stats = self._compute_stats(month, year)
        self.kpi["total_employees"].set(f"{int(stats['emp_total'])}")
        self.kpi["active_employees"].set(f"{int(stats['emp_active'])}")
        self.kpi["gross"].set(self._fnum(stats["gross"]))
        self.kpi["deductions"].set(self._fnum(stats["deductions"]))
        self.kpi["thirdparty"].set(self._fnum(stats["third"]))
        self.kpi["net"].set(self._fnum(stats["net"]))
        self.kpi["ecs"].set(self._fnum(stats["ecs"]))

        self._render_pie_chart()

    def _compute_stats(self, month, year):
        with sqlite3.connect(DB_FILE) as con:
            emp_total = con.execute("SELECT COUNT(*) FROM employee").fetchone()[0] or 0
            emp_active = con.execute(
                "SELECT COUNT(DISTINCT ecs_no) FROM earning WHERE month=? AND year=?", (month, year)
            ).fetchone()[0] or 0

            earn_cols = ("basic_pay","da","hra","ta","da_arrears","hra_arrears","ta_arrears","fda","ra","sda","others")
            earn_sum_sql = " + ".join([f"IFNULL({c},0)" for c in earn_cols])
            gross = con.execute(
                f"SELECT IFNULL(SUM({earn_sum_sql}),0) FROM earning WHERE month=? AND year=?",
                (month, year)
            ).fetchone()[0] or 0.0

            ded_cols = ("cpf_emp","saving_fund","insurance_fund","hba","mca","income_tax")
            ded_sum_sql = " + ".join([f"IFNULL({c},0)" for c in ded_cols])
            deductions = con.execute(
                f"SELECT IFNULL(SUM({ded_sum_sql}),0) FROM earning WHERE month=? AND year=?",
                (month, year)
            ).fetchone()[0] or 0.0

            lic_sum = con.execute(
                "SELECT IFNULL(SUM(premium_amount),0) FROM lic_premiums WHERE month=? AND year=?", (month, year)
            ).fetchone()[0] or 0.0
            loan_sum = con.execute(
                "SELECT IFNULL(SUM(loan_installment),0) FROM loan_deductions WHERE month=? AND year=?", (month, year)
            ).fetchone()[0] or 0.0
            third = (lic_sum or 0) + (loan_sum or 0)

        net = gross - deductions
        ecs = net - third
        return {"emp_total": emp_total, "emp_active": emp_active, "gross": gross,
                "deductions": deductions, "third": third, "net": net, "ecs": ecs}

    def _get_earnings_breakdown(self, month, year):
        cols = [
            ("Basic Pay", "basic_pay"), ("DA", "da"), ("HRA", "hra"), ("TA", "ta"),
            ("DA Arrears", "da_arrears"), ("HRA Arrears", "hra_arrears"),
            ("TA Arrears", "ta_arrears"), ("FDA", "fda"), ("RA", "ra"),
            ("SDA", "sda"), ("Others", "others"),
        ]
        with sqlite3.connect(DB_FILE) as con:
            sums = {}
            for label, col in cols:
                val = con.execute(
                    f"SELECT IFNULL(SUM({col}),0) FROM earning WHERE month=? AND year=?",
                    (month, year)
                ).fetchone()[0] or 0.0
                sums[label] = float(val)
        return sums

    # ---------- chart + breakdown ----------
    def _render_pie_chart(self, redraw_only=False):
        # clear description list
        for w in self.desc_list.winfo_children():
            w.destroy()

        month, year = get_active_month_year()
        breakdown = self._get_earnings_breakdown(month, year)
        data = {k: v for k, v in breakdown.items() if v > 0}
        total = sum(data.values())

        # show “no data” message
        if not data or total == 0:
            for w in self._chart_area.winfo_children(): w.destroy()
            ctk.CTkLabel(self._chart_area, text=f"No earning data for {month} {year}",
                         font=("Segoe UI", 13)).pack(padx=12, pady=20)
            return

        # ---- Matplotlib figure (fits inside card) ----
        # Determine a reasonable size from the area’s pixel size
        w = max(self._chart_area.winfo_width(), 520)
        h = max(self._chart_area.winfo_height(), 280)
        dpi = 100
        figsize = (w / dpi, h / dpi)

        # Destroy old canvas
        if self._chart_canvas is not None:
            try:
                self._chart_canvas.get_tk_widget().destroy()
            except Exception:
                pass
            self._chart_canvas = None

        fig = Figure(figsize=figsize, dpi=dpi)
        ax = fig.add_subplot(111)
        # leave space around edges so nothing clips
        fig.subplots_adjust(left=0.02, right=0.98, top=0.98, bottom=0.02)

        labels = list(data.keys())
        values = list(data.values())

        colors = [
            "#0ea5e9", "#14b8a6", "#8b5cf6", "#f59e0b", "#f43f5e",
            "#10b981", "#6366f1", "#06b6d4", "#84cc16", "#ef4444", "#a855f7"
        ][:len(values)]

        def _autopct(pct):
            return f"{pct:.1f}%" if pct >= 2.5 else ""  # only show if >= 2.5% to avoid clutter

        ax.pie(
            values,
            labels=None,
            autopct=_autopct,
            startangle=90,
