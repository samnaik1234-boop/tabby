        if getattr(self, "_selected_month", None) and getattr(self, "_selected_year", None):
            return self._selected_month, self._selected_year
        return get_active_month_year()


    def refresh_active_month_year(self):
        # ONLY update month/year vars and reload bank/branch info
        month, year = get_active_month_year()
        self.active_month_var.set(month)
        self.active_year_var.set(year)

        self._bank_to_br = {}
        with sqlite3.connect(DB_FILE) as con:
            for bn, br in con.execute("SELECT bank_name,branch_addr FROM bank"):
                self._bank_to_br.setdefault(bn, []).append(br)

    def get_current_da_hra_ta(self):
        with sqlite3.connect(DB_FILE) as con:
            cur = con.cursor()
            cur.execute("""
                SELECT da, hra, ta, tah FROM da_hra_ta
                ORDER BY CAST(year AS INT) DESC,
                        CASE month
                            WHEN 'JANUARY' THEN 1 WHEN 'FEBRUARY' THEN 2 WHEN 'MARCH' THEN 3
                            WHEN 'APRIL' THEN 4 WHEN 'MAY' THEN 5 WHEN 'JUNE' THEN 6
                            WHEN 'JULY' THEN 7 WHEN 'AUGUST' THEN 8 WHEN 'SEPTEMBER' THEN 9
                            WHEN 'OCTOBER' THEN 10 WHEN 'NOVEMBER' THEN 11 WHEN 'DECEMBER' THEN 12
                            ELSE 0 END DESC
                LIMIT 1
            """)
            dam = cur.fetchone()
            if dam:
