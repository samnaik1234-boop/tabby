    def generate_sav_ins_report(self):
        """
        Savings / Insurance Fund schedule (open-first flow).
        Second table fits portrait A4; all cells centered; total row bold.
        """
        import os, sys, subprocess, tempfile, webbrowser, sqlite3
        from tkinter import messagebox
        from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer
        from reportlab.lib.pagesizes import A4, portrait
        from reportlab.lib.styles import ParagraphStyle
        from reportlab.lib.units import mm
        from reportlab.lib import colors

        # ---- styles ----
        styles = {
            'wrap':   ParagraphStyle('wrap',   fontName='CourierNew', fontSize=9,  alignment=0, leading=12, wordWrap='CJK'),
            'header': ParagraphStyle('header', fontName='CourierNew', fontSize=15, alignment=1, leading=18, spaceAfter=10),
            'center': ParagraphStyle('center', fontName='CourierNew', fontSize=12, alignment=1, leading=14, spaceAfter=6),
            'left':   ParagraphStyle('left',   fontName='CourierNew', fontSize=11, alignment=0, leading=13, spaceAfter=2),
            'small':  ParagraphStyle('small',  fontName='CourierNew', fontSize=9,  alignment=1),
        }
        styles['center_bold'] = ParagraphStyle('center_bold', parent=styles['center'], fontName='CourierNew-Bold')
        styles['wrap_bold']   = ParagraphStyle('wrap_bold',   parent=styles['wrap'],   fontName='CourierNew-Bold')
        styles['left_bold']   = ParagraphStyle('left_bold',   parent=styles['left'],   fontName='CourierNew-Bold')

        # ---- helpers ----
        def fnum(x):
            try:
                return "{:,}".format(int(round(float(x or 0))))
            except Exception:
                return "0"

        try:
            total_in_words_fn = total_in_words
        except NameError:
            from num2words import num2words
            def total_in_words_fn(val):
                return num2words(int(round(val or 0)), lang='en_IN').upper() + " ONLY"

        def _open_pdf(path: str):
            try:
                if sys.platform.startswith("win"):
                    os.startfile(path)  # type: ignore[attr-defined]
                elif sys.platform == "darwin":
                    subprocess.Popen(["open", path])
                else:
                    subprocess.Popen(["xdg-open", path])
                return
            except Exception:
                try:
                    webbrowser.open_new("file://" + os.path.abspath(path))
                except Exception:
                    messagebox.showinfo("Saved", f"Report written to:\n{path}")

        # active month/year
        month, year = get_report_month_year()

        # ---- fetch data ----
        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT 
                    e.name, e.cpf_no, e.designation,
                    IFNULL(earn.saving_fund, 0) AS sf,
                    IFNULL(earn.insurance_fund, 0) AS inf
                FROM employee e
                JOIN earning earn
                    ON e.ecs_no = earn.ecs_no
            AND earn.month = ?
            AND earn.year  = ?
                ORDER BY e.name
            """, (month, year)).fetchall()

        if not rows:
            messagebox.showwarning("No Data", f"No Saving/Insurance entries for {month} {year}.")
            return

        tot_sf  = sum(float(r[3] or 0) for r in rows)
        tot_inf = sum(float(r[4] or 0) for r in rows)
        grand   = tot_sf + tot_inf
        emp_cnt = len(rows)

        # ---- build doc ----
        elements = []
        elements.append(Paragraph("GOVERNMENT OF GOA", styles['header']))
        elements.append(Paragraph("ELECTRICITY", styles['center']))
        elements.append(Paragraph("EX. ENGR. ELECT DIVN. X, CURTI, PONDA", styles['center']))
        elements.append(Spacer(1, 3*mm))

        elements.append(Paragraph("Schedule under Goa State Government Employees Group Insurance Scheme 1996", styles['center_bold']))
        elements.append(Paragraph("(To be attached to the Pay Bill every month)", styles['small']))
        elements.append(Spacer(1, 2*mm))
        elements.append(Paragraph("8011 - Insurance and Pension Fund | 107 - Goa State Employees Group Insurance Scheme", styles['small']))
        elements.append(Paragraph("01 - Saving Fund 8011-00-107-01-00   |   02 - Insurance Fund 8011-00-107-02-00", styles['small']))
        elements.append(Spacer(1, 2*mm))

        elements.append(Paragraph(f"DDO: 858", styles['left']))
        elements.append(Paragraph(f"Month: {month}, {year}", styles['left']))
        elements.append(Paragraph("All figures are in ₹.", styles['left']))
        elements.append(Spacer(1, 4*mm))

        # ---- SECOND TABLE (compact summary with 'C' row + bold TOTAL row) ----
        styles['wrap_center'] = ParagraphStyle(
            'wrap_center', fontName='CourierNew', fontSize=9, alignment=1, leading=12, wordWrap='CJK'
        )
        styles['wrap_center_bold'] = ParagraphStyle(
            'wrap_center_bold', parent=styles['wrap_center'], fontName='CourierNew-Bold'
        )

        headers = [
            "Classification of Group", "No. of Employees",
            "Saving Fund", "Insurance Fund", "Grand Total"
        ]

        table2_data = [
            [Paragraph(h, styles['wrap_center']) for h in headers],

            # Row for Group 'C' (not bold)
            [
                Paragraph("C", styles['wrap_center']),
                Paragraph(str(emp_cnt), styles['wrap_center']),
                Paragraph(fnum(tot_sf), styles['wrap_center']),
                Paragraph(fnum(tot_inf), styles['wrap_center']),
                Paragraph(fnum(grand), styles['wrap_center']),
            ],

            # TOTAL row (BOLD)
            [
                Paragraph("TOTAL", styles['wrap_center_bold']),
                Paragraph(str(emp_cnt), styles['wrap_center_bold']),
                Paragraph(fnum(tot_sf), styles['wrap_center_bold']),
                Paragraph(fnum(tot_inf), styles['wrap_center_bold']),
                Paragraph(fnum(grand), styles['wrap_center_bold']),
            ],
        ]

        # Fit to portrait A4 content width (210mm - 15mm - 15mm = 180mm)
        PAGE_W, _ = portrait(A4)
        content_w = PAGE_W - 15*mm - 15*mm
        w1 = content_w * 0.29
        w_rest = (content_w - w1) / 4

        table2 = Table(table2_data, colWidths=[w1, w_rest, w_rest, w_rest, w_rest])
        table2.setStyle(TableStyle([
            ('FONTNAME', (0,0), (-1,-1), 'CourierNew'),
            ('FONTSIZE', (0,0), (-1,0), 10),
            ('FONTSIZE', (0,1), (-1,-1), 9),
            ('BACKGROUND', (0,0), (-1,0), colors.lightgrey),
            ('GRID', (0,0), (-1,-1), 0.5, colors.black),
            ('ALIGN', (0,0), (-1,-1), 'CENTER'),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
            ('LEFTPADDING', (0,0), (-1,-1), 2),
            ('RIGHTPADDING', (0,0), (-1,-1), 2),
            ('TOPPADDING', (0,0), (-1,-1), 2),
            ('BOTTOMPADDING', (0,0), (-1,-1), 2),

            # line above TOTAL row
            ('LINEABOVE', (0, -1), (-1, -1), 1.0, colors.black),
        ]))
        elements.append(table2)

        # words + footer
        words = total_in_words_fn(grand)
        elements.append(Paragraph(f"(Rupees {words})", styles['small']))
        elements.append(Spacer(1, 4*mm))
        elements.append(Paragraph("(This report is computer generated. No physical signature is required)", styles['small']))

        # ---- page number ----
        def add_page_number(c, doc):
            c.saveState()
            c.setFont('Courier', 10)
            c.drawRightString(200*mm, 10*mm, f"Page {doc.page}")
            c.restoreState()

        # ---- write to temp, then open ----
        tmp_path = os.path.join(tempfile.gettempdir(), f"Sav_Ins_Fund_{month}_{year}.pdf")
        doc = SimpleDocTemplate(
            tmp_path,
            pagesize=portrait(A4),
            topMargin=18*mm, bottomMargin=14*mm, leftMargin=15*mm, rightMargin=15*mm
        )
        doc.build(elements, onFirstPage=add_page_number, onLaterPages=add_page_number)

        _open_pdf(tmp_path)

        # open the PDF in default viewer
        try:
            if sys.platform.startswith("win"):
                os.startfile(tmp_path)  # type: ignore[attr-defined]
            elif sys.platform == "darwin":
                subprocess.Popen(["open", tmp_path])
            else:
                subprocess.Popen(["xdg-open", tmp_path])
        except Exception:
            import webbrowser
            webbrowser.open_new("file://" + os.path.abspath(tmp_path))


    def generate_income_tax_report(self):
        """
        Income Tax (TDS) Schedule
        Pulls employees with Income Tax > 0 for the active month/year from earning.income_tax.
        Layout: Government of Goa header, Head of Account block (TDS Sec 192),
        month line, table (Sr, Designation, Employee Name (PAN), Amount of Income Tax),
        total + words, Signature of DDO (right).
        """
       

        # ---------- styles ----------
        styles = {
            'wrap':     ParagraphStyle('wrap',     fontName='CourierNew',      fontSize=9,   leading=12, alignment=0, wordWrap='CJK'),
            'wrap_b':   ParagraphStyle('wrap_b',   fontName='CourierNew-Bold', fontSize=9,   leading=12, alignment=0, wordWrap='CJK'),
            'wrap_c':   ParagraphStyle('wrap_c',   fontName='CourierNew',      fontSize=9,   leading=12, alignment=1, wordWrap='CJK'),
            'wrap_r':   ParagraphStyle('wrap_r',   fontName='CourierNew',      fontSize=9,   leading=12, alignment=2, wordWrap='CJK'),
            'header':   ParagraphStyle('header',   fontName='CourierNew',      fontSize=15,  leading=18, alignment=1, spaceAfter=10),
            'center':   ParagraphStyle('center',   fontName='CourierNew',      fontSize=12,  leading=14, alignment=1, spaceAfter=6),
            'left':     ParagraphStyle('left',     fontName='CourierNew',      fontSize=11,  leading=13, alignment=0, spaceAfter=2),
            'small':    ParagraphStyle('small',    fontName='CourierNew',      fontSize=9,   leading=11, alignment=0),
        }
        styles['small_right'] = ParagraphStyle('small_right', parent=styles['small'], alignment=2)

        # ---------- helpers ----------
        def _open_pdf(path: str):
            try:
                if sys.platform.startswith("win"):
                    os.startfile(path)  # type: ignore[attr-defined]
                elif sys.platform == "darwin":
                    subprocess.Popen(["open", path])
                else:
                    subprocess.Popen(["xdg-open", path])
            except Exception:
                try:
                    webbrowser.open_new("file://" + os.path.abspath(path))
                except Exception:
                    messagebox.showinfo("Saved", f"Report written to:\n{path}")

        try:
            fnum_fn = fnum
        except NameError:
            def fnum_fn(x):
                try:
                    return "{:,}".format(int(round(float(x or 0))))
                except Exception:
                    return "0"

        try:
            total_words = total_in_words
        except NameError:
            from num2words import num2words
            def total_words(val): return num2words(int(round(val or 0)), lang='en_IN').upper() + " ONLY"

        # ---------- data ----------
        month, year = get_report_month_year()

        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT 
                    e.name, e.designation, e.pan_no,
                    IFNULL(earn.income_tax, 0.0) AS itax
                FROM employee e
                JOIN earning earn
                ON e.ecs_no = earn.ecs_no
                AND earn.month = ?
                AND earn.year  = ?
                WHERE IFNULL(earn.income_tax,0) > 0
                ORDER BY e.name
            """, (month, year)).fetchall()

        if not rows:
            try:
                messagebox.showwarning("No Data", f"No Income Tax deductions found for {month} {year}.")
            finally:
                return

        # ---------- compute table ----------
        table_data = [[
            Paragraph("Sr", styles['wrap_c']),
            Paragraph("Designation", styles['wrap']),
            Paragraph("Employee Name (PAN)", styles['wrap']),
            Paragraph("Amount of Income Tax", styles['wrap_r']),
        ]]

        grand_total = 0.0
        for i, (name, desig, pan, itax) in enumerate(rows, start=1):
            try:
                amt = float(itax or 0)
            except Exception:
                amt = 0.0
            grand_total += amt

            name_cell = f"{name or ''}"
            if pan:
                name_cell += f"  (<font size=8>{pan}</font>)"

            table_data.append([
                Paragraph(str(i), styles['wrap_c']),
                Paragraph(desig or "", styles['wrap']),
                Paragraph(name_cell, styles['wrap']),
                Paragraph(fnum_fn(amt), styles['wrap_r']),
            ])

        # totals row (bold)
        table_data.append([
            Paragraph("TOTAL", styles['wrap_b']), "", "",
            Paragraph(fnum_fn(grand_total), styles['wrap_b']),
        ])

        # ---------- document ----------
        elements = []
        elements.append(Paragraph("Government of Goa", styles['header']))
        elements.append(Paragraph("ELECTRICITY", styles['center']))
        elements.append(Paragraph("EX. ENGR. ELECT DIVN. X, CURTI, PONDA", styles['center']))
        elements.append(Spacer(1, 2*mm))

        elements.append(Paragraph("Schedule of TDS", styles['center']))
        elements.append(Paragraph("Statement showing the analysis of the tax deducted at source (TDS) for Government Employees (Sec 192)", styles['center']))
        elements.append(Paragraph(f"Month: <b>{month}</b> , <b>{year}</b>", styles['left']))
        elements.append(Spacer(1, 2*mm))

        # page/content geometry
        PAGE_W, PAGE_H = portrait(A4)
        LEFT_MARGIN  = 10*mm
        RIGHT_MARGIN = 10*mm
        CONTENT_W = PAGE_W - LEFT_MARGIN - RIGHT_MARGIN

        # ---- Head of Account (TDS – Sec 192) + right admin block ----
        head_block = (
            "8658-Suspense Account\n"
            "00________________\n"
            "112-Tax Deduction at source (TDS)\n"
            "01-Government Employees (sec 192)\n"
            "00"
       
            
            
        )
        right_block = (
            "S.T.O.: 16\n"
            "D.D.O.: 858\n"
            "Bill No:________________"
        )

        header_tbl = Table(
            [[
                Paragraph(head_block.replace("\n", "<br/>"), styles['small']),
                Paragraph(right_block.replace("\n", "<br/>"), styles['small_right']),
            ]],
            colWidths=[CONTENT_W*0.62, CONTENT_W*0.38],
        )
        header_tbl.setStyle(TableStyle([
            ('VALIGN', (0,0), (-1,-1), 'TOP'),
            ('ALIGN',  (0,0), (0,0), 'LEFT'),
            ('ALIGN',  (1,0), (1,0), 'RIGHT'),
            ('LEFTPADDING',  (0,0), (0,0), 0),
            ('RIGHTPADDING', (1,0), (1,0), 0),
            ('TOPPADDING',   (0,0), (-1,-1), 0),
            ('BOTTOMPADDING',(0,0), (-1,-1), 2),
        ]))
        elements.append(header_tbl)
        elements.append(Spacer(1, 4*mm))

        # ---- table (auto-fit to width) ----
        base_widths_mm = [12, 60, 92, 24]  # Sr | Designation | Name(PAN) | Amount
        scale = CONTENT_W / sum(w*mm for w in base_widths_mm)
        col_widths = [(w*mm) * scale for w in base_widths_mm]

        t = Table(table_data, colWidths=col_widths, repeatRows=1)
        t.setStyle(TableStyle([
            ('FONTNAME', (0,0), (-1,-1), 'CourierNew'),
            ('FONTSIZE', (0,0), (-1,0), 9.5),
            ('FONTSIZE', (0,1), (-1,-1), 9),
            ('BACKGROUND', (0,0), (-1,0), colors.lightgrey),
            ('GRID', (0,0), (-1,-1), 0.5, colors.black),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),

            ('ALIGN', (0,0), (0,-1), 'CENTER'),  # Sr
            ('ALIGN', (1,1), (2,-2), 'LEFT'),    # Designation, Name
            ('ALIGN', (3,1), (3,-2), 'RIGHT'),   # Amounts

            # totals row
            ('LINEABOVE', (0,-1), (-1,-1), 1.0, colors.black),
            ('FONTNAME', (0,-1), (-1,-1), 'CourierNew-Bold'),

            ('LEFTPADDING',  (0,0), (-1,-1), 2),
            ('RIGHTPADDING', (0,0), (-1,-1), 2),
            ('TOPPADDING',   (0,0), (-1,-1), 2),
            ('BOTTOMPADDING',(0,0), (-1,-1), 2),
        ]))
        elements.append(t)
        elements.append(Spacer(1, 6*mm))

        # total in words + signature
        elements.append(Paragraph(f"(Rupees  {total_words(grand_total)})", styles['small']))
        elements.append(Spacer(1, 3*mm))
        elements.append(Paragraph("Signature of DDO", styles['small_right']))
        elements.append(Spacer(1, 2*mm))
        elements.append(Paragraph("(This report is computer generated. No physical signature is required)", styles['small']))

        # page number
        def add_page_number(c, doc):
            c.saveState()
            c.setFont('Courier', 10)
            c.drawRightString(200*mm, 10*mm, f"Page {doc.page}")
            c.restoreState()

        # write + open
        tmp_path = os.path.join(tempfile.gettempdir(), f"Income_Tax_Report_{month}_{year}.pdf")
        doc = SimpleDocTemplate(
            tmp_path,
            pagesize=portrait(A4),
            topMargin=18*mm, bottomMargin=14*mm,
            leftMargin=LEFT_MARGIN, rightMargin=RIGHT_MARGIN
