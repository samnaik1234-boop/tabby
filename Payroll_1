# ------------ PERSONAL DETAILS FRAME -------------
class PersonalDetailsFrame(ctk.CTkFrame):
    def __init__(self, master, controller, sub_division_list, section_office_list):
        super().__init__(master)
        self.controller = controller
        self.sub_division_list = sub_division_list
        self.section_office_list = section_office_list
        self._build()

    def _force_upper(self, evt, entry):
        v = entry.get().upper()
        entry.delete(0,"end"); entry.insert(0,v)

    def _update_retirement_date(self, event=None):
        dob_str = self.entries["DATE OF BIRTH"].get().strip()
        retire_entry = self.entries["DATE OF RETIREMENT"]
        if not dob_str or len(dob_str) < 8:
            retire_entry.configure(state="normal")
            retire_entry.delete(0, "end")
            retire_entry.configure(state="readonly")
            return
        try:
            dob = datetime.strptime(dob_str, "%d/%m/%Y")
            retire_year = dob.year + 60
            last_day = calendar.monthrange(retire_year, dob.month)[1]
            retire_date = date(retire_year, dob.month, last_day)
            ret_str = retire_date.strftime("%d/%m/%Y")
        except Exception as e:
            print("Retirement calculation error:", e)
            ret_str = ""
        retire_entry.configure(state="normal")
        retire_entry.delete(0, "end")
        retire_entry.insert(0, ret_str)
        retire_entry.configure(state="readonly")
    
    def refresh_designations(self):
        menu = self.entries["DESIGNATION"]
        vals = self.controller.designations or [""]
        menu.configure(values=vals)
        if vals:
            # keep current selection if still present; else use first
            cur = menu.get()
            menu.set(cur if cur in vals else vals[0])


            
    def update_section_offices(self, subdiv):
        brs = self.controller.subdiv_so_dict.get(subdiv,[])
        e = self.entries["SECTION OFFICE"]
        e.configure(values=brs or [""])
        e.set(brs[0] if brs else "")

    def _validate_all(self):
        E = self.entries
        if not E["NAME"].get().strip():
            messagebox.showwarning("Validation","Enter a valid Name."); return False
        m = E["MOBILE NO"].get().strip()
        if not (m.isdigit() and len(m)==10):
            messagebox.showwarning("Validation","Enter valid 10-digit Mobile."); return False
        p = E["PAN NO"].get().strip()
        if p and len(p)!=10:
            messagebox.showwarning("Validation","PAN must be 10 chars."); return False
        if not E["ECS NO"].get().strip():
            messagebox.showwarning("Validation","ECS NO cannot be empty."); return False
        return True

    def _build(self):
        fields = [
                ("ECS NO", False), ("NAME", False), ("ADDRESS", False),
                ("DATE OF JOINING", False), ("CPF NO", False), ("PAN NO", False),
                ("MOBILE NO", False), ("DESIGNATION", False), ("QUALIFICATION", False),
                ("DATE OF BIRTH", False), ("DATE OF RETIREMENT", True),
                ("LEVEL", False), ("BASIC PAY", False),
                ("PHYSICALLY CHALLENGED", False), ("PRAN NO", False),
                ("SUB-DIV", False), ("SECTION OFFICE", False)
            ]

        form = ctk.CTkFrame(self, fg_color="transparent")
        form.pack(fill="x",padx=15,pady=10)
        self.entries = {}
        for idx,(lbl,ro) in enumerate(fields):
            r,c = divmod(idx,3)
            tk = ctk.CTkLabel(form,text=lbl,font=("Arial",11,"bold"))
            tk.grid(row=r*2,column=c,sticky="w",padx=7,pady=(4,0))
            if lbl=="DATE OF BIRTH":
                ent = DateEntry(form,width=18,date_pattern="dd/MM/yyyy",
                                font=("Arial",11))
                # Bind both date select and text entry
                ent.bind("<<DateEntrySelected>>", self._update_retirement_date)
                ent.bind("<FocusOut>", self._update_retirement_date)
                ent.bind("<KeyRelease>", self._update_retirement_date)

            elif lbl=="DATE OF JOINING":
                ent = DateEntry(form,width=18,date_pattern="dd/MM/yyyy",
                                font=("Arial",11))
            elif lbl=="DATE OF RETIREMENT":
                ent = ctk.CTkEntry(form,width=180); ent.configure(state="readonly")
            elif lbl=="PHYSICALLY CHALLENGED":
                ent = ctk.CTkOptionMenu(form,width=180,values=["YES","NO"])
                ent.set("NO")
            elif lbl=="SUB-DIV":
                ent = ctk.CTkOptionMenu(form,width=180,
                                        values=self.sub_division_list or [""],
                                        command=self.update_section_offices)
                ent.set(self.sub_division_list[0] if self.sub_division_list else "")
            elif lbl=="SECTION OFFICE":
                ent = ctk.CTkOptionMenu(form,width=180,
                                        values=self.section_office_list or [""])
                ent.set(self.section_office_list[0] if self.section_office_list else "")
            elif lbl=="DESIGNATION":
                ent = ctk.CTkOptionMenu(form, width=180, values=self.controller.designations or [""])
                if self.controller.designations:
                    ent.set(self.controller.designations[0])

            else:
                ent = ctk.CTkEntry(form,width=180)
                ent.bind("<KeyRelease>",lambda e,en=ent: self._force_upper(e,en))
            ent.grid(row=r*2+1,column=c,sticky="ew",padx=7,pady=(0,6))
            self.entries[lbl]=ent
        for i in range(3): form.grid_columnconfigure(i,weight=1)

        btns = ctk.CTkFrame(self,fg_color="transparent")
        btns.pack(pady=(0,10))
        for txt,cmd in [("SAVE",self.save_form),
                        ("UPDATE",self.update_form),
                        ("DELETE",self.delete_form),
                        ("CLEAR",self.clear_form)]:
