    # ========== Utility & Handlers ==========
    def _update_cpf_fields(self):
        try:
            b = float(self.basic_var.get() or 0)
            da = float(self.earn_vars["da_var"].get() or 0)
            dara = float(self.earn_vars["da_arrears_var"].get() or 0)
            base = b + da + dara
            cpf_e = round(base*0.10, 2)
            cpf_g = round(base*0.14, 2)
        except:
            cpf_e = cpf_g = 0
        self.deduction_vars['cpf_emp'].set(str(cpf_e))
        self.deduction_vars['cpf_govt'].set(str(cpf_g))


    def fetch_employee(self):
        ecs = self.ecs_entry.get().strip().upper()
        month, year = get_active_month_year()
        if not (ecs):
            return messagebox.showwarning("Input","Enter ECS No, Month & Year")

        row = fetch_employee_by_ecs(ecs)
        if not row:
            messagebox.showerror("Not Found","No employee with this ECS No")
            self.name_var.set("")
            self.desig_var.set("")
            self.basic_var.set("")

            for d in (self.earn_vars,self.deduction_vars,getattr(self,"third_vars",{})):
                for v in d.values(): v.set("0")
            return

        # set name/designation/basic
        self.name_var.set(row["name"].upper())
        self.desig_var.set(row["designation"].upper())
        self.basic_var.set(str(row["basic_pay"]))

        # fetch DA/HRA/TA master
        with sqlite3.connect(DB_FILE) as con:
            dam = con.execute(
                "SELECT da,hra,ta,tah FROM da_hra_ta WHERE month=? AND year=?",
                (month,year)
            ).fetchone()
            if dam is None:
                dam = con.execute(
                    "SELECT da,hra,ta,tah FROM da_hra_ta "
                    "WHERE (year<? OR (year=? AND month<=?)) "
                    "ORDER BY year DESC, month DESC LIMIT 1",
                    (year,year,month)
                ).fetchone()

        da_pct, hra_pct, ta_b, tah_b = self.get_current_da_hra_ta()
        self.da_percent_var.set(str(da_pct))
        self.hra_percent_var.set(str(hra_pct))

        # compute amounts
        b = float(row["basic_pay"])
        da_amt  = round(b*da_pct/100)
        hra_amt = round(b*hra_pct/100)
        if b >= 24200:
            ta_use = tah_b
            ta_amt = round(tah_b*(da_pct/100)+tah_b)
        else:
            ta_use = ta_b
            ta_amt = round(ta_b*(da_pct/100)+ta_b)

        # push into entries
        self.ta_master_var.set(str(ta_use))
        self.da_entry .delete(0,"end"); self.da_entry.insert(0,str(da_amt))
        self.hra_entry.delete(0,"end"); self.hra_entry.insert(0,str(hra_amt))
        self.ta_entry .delete(0,"end"); self.ta_entry.insert(0,str(ta_amt))

        # …then load any existing row (omitted here for brevity)
        self.load_tree()
        self.load_loans()
        self.load_lics()
        self._load_thirdparty_totals()      # ← add this
        self.update_summary()

