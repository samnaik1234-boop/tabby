        self.controller = controller
        self._build()
        self.load_tree()

    def _only_digits(self, P):
        return P.isdigit() or P == ""

    def _build(self):
        ctk.CTkLabel(self, text="BANK MASTER",
                     font=("Arial",18,"bold")).pack(pady=18)
        form = ctk.CTkFrame(self,fg_color="transparent")
        form.pack(fill="x",padx=25,pady=4)

        labels = ["BANK NAME","BRANCH ADDRESS","MICR NO","IFSC NO","ACCOUNT NO"]
        self.vars = {}
        for idx, lbl in enumerate(labels):
            ctk.CTkLabel(form,text=lbl,
                         font=("Arial",11,"bold"))\
               .grid(row=0,column=idx,sticky="w",padx=7,pady=(4,0))
            var = ctk.StringVar()
            ent = ctk.CTkEntry(form,width=180,textvariable=var)
            ent.grid(row=1,column=idx,sticky="ew",padx=7,pady=(0,8))
            self.vars[lbl] = var
            # uppercase or digits
