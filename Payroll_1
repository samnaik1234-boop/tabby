    def generate_staff_details_pdf(self):
       

        # styles
        styles = {
            'wrap':   ParagraphStyle('wrap',   fontName='CourierNew', fontSize=8.5, leading=11, alignment=0, wordWrap='CJK'),
            'wrap_b': ParagraphStyle('wrap_b', fontName='CourierNew-Bold', fontSize=8.5, leading=11, alignment=0, wordWrap='CJK'),
            'header': ParagraphStyle('header', fontName='CourierNew', fontSize=15, leading=18, alignment=1, spaceAfter=10),
            'center': ParagraphStyle('center', fontName='CourierNew', fontSize=12, leading=14, alignment=1, spaceAfter=6),
        }

        # fetch
        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT
                    ecs_no, name, designation, qualification, dob, doj, cpf_no, pan_no,
                    mobile_no, pran_no, level, basic_pay, sub_div, so, address, phys_challenged
                FROM employee
                ORDER BY name
            """).fetchall()
        if not rows:
            messagebox.showwarning("No Data", "No staff records found.")
            return

        headers = [
            "Sr","ECS No","Name","Designation","Qualification",
            "DOB","DOJ","CPF No","PAN","Mobile",
            "PRAN","Level","Basic Pay",
            "Sub-Div","S.O.","Address","Phys. Challenged"
        ]
        data = [[Paragraph(h, styles['wrap_b']) for h in headers]]

        def fnum(x):
            try: return "{:,}".format(int(round(float(x or 0))))
            except: return "0"

        for i, r in enumerate(rows, 1):
            ecs_no, name, desig, qual, dob, doj, cpf, pan, mob, pran, level, basic, subdiv, so, addr, phys = r
            data.append([
                Paragraph(str(i), styles['wrap']),
                Paragraph(ecs_no or "", styles['wrap']),
                Paragraph(name or "", styles['wrap']),
                Paragraph(desig or "", styles['wrap']),
                Paragraph(qual or "", styles['wrap']),
                Paragraph(dob or "", styles['wrap']),
                Paragraph(doj or "", styles['wrap']),
                Paragraph(cpf or "", styles['wrap']),
                Paragraph(pan or "", styles['wrap']),
                Paragraph(mob or "", styles['wrap']),
                Paragraph(pran or "", styles['wrap']),
                Paragraph(level or "", styles['wrap']),
                Paragraph(fnum(basic), styles['wrap']),
                Paragraph(subdiv or "", styles['wrap']),
                Paragraph(so or "", styles['wrap']),
                Paragraph(addr or "", styles['wrap']),
                Paragraph((phys or "").upper(), styles['wrap']),
            ])

        # page geometry (Legal landscape) + auto-fit columns
        PAGE_W, _ = landscape(legal)
        LEFT, RIGHT = 10*mm, 10*mm
        CONTENT_W = PAGE_W - LEFT - RIGHT
        base_mm = [10,18,36,26,28, 18,18,24,22,24, 24,12,18, 20,18,60,18]
        scale = CONTENT_W / sum(w*mm for w in base_mm)
        col_widths = [(w*mm) * scale for w in base_mm]

        elements = [
            Paragraph("Government of Goa", styles['header']),
            Paragraph("ELECTRICITY", styles['center']),
            Paragraph("EX. ENGR. ELECT DIVN. X, CURTI, PONDA", styles['center']),
            Spacer(1, 3*mm),
            Paragraph("STAFF DETAILS REPORT", styles['center']),
            Spacer(1, 3*mm),
            Table(data, colWidths=col_widths, repeatRows=1)
        ]
        elements[-1].setStyle(TableStyle([
            ('FONTNAME', (0,0), (-1,-1), 'CourierNew'),
            ('FONTSIZE', (0,0), (-1,0), 9),
            ('FONTSIZE', (0,1), (-1,-1), 8.5),
            ('BACKGROUND', (0,0), (-1,0), colors.lightgrey),
            ('GRID', (0,0), (-1,-1), 0.4, colors.black),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
            ('ALIGN', (0,0), (0,-1), 'CENTER'),
            ('ALIGN', (12,1), (12,-1), 'RIGHT'),
            ('LEFTPADDING',  (0,0), (-1,-1), 2),
            ('RIGHTPADDING', (0,0), (-1,-1), 2),
            ('TOPPADDING',   (0,0), (-1,-1), 1.5),
            ('BOTTOMPADDING',(0,0), (-1,-1), 1.5),
        ]))

        def add_page_number(c, doc):
            c.saveState(); c.setFont('Courier', 10)
            c.drawRightString(330*mm, 10*mm, f"Page {doc.page}")
            c.restoreState()

        pdf_path = self._temp_pdf_path("Staff_Details_Legal")
        doc = SimpleDocTemplate(
            pdf_path, pagesize=landscape(legal),
            topMargin=18*mm, bottomMargin=14*mm, leftMargin=LEFT, rightMargin=RIGHT
        )
        doc.build(elements, onFirstPage=add_page_number, onLaterPages=add_page_number)
        self._open_file(pdf_path)
        self._last_pdf_path = pdf_path


    def export_staff_details_excel(self):
        """Staff Details → Excel (.xlsx). Falls back to CSV if openpyxl not available."""
        import os, sys, subprocess, tempfile, webbrowser, sqlite3, csv
        from tkinter import messagebox
        from datetime import datetime

        with sqlite3.connect(DB_FILE) as con:
            rows = con.execute("""
                SELECT
                    ecs_no, name, designation, qualification, dob, doj, cpf_no, pan_no,
                    mobile_no, pran_no, level, basic_pay, sub_div, so, address, phys_challenged
                FROM employee
                ORDER BY name
            """).fetchall()
        if not rows:
            messagebox.showwarning("No Data", "No staff records found.")
            return

        headers = [
            "Sr","ECS No","Name","Designation","Qualification",
            "DOB","DOJ","CPF No","PAN","Mobile",
            "PRAN","Level","Basic Pay",
            "Sub-Div","S.O.","Address","Phys. Challenged"
        ]
        excel_rows = []
        for i, r in enumerate(rows, 1):
            ecs_no, name, desig, qual, dob, doj, cpf, pan, mob, pran, level, basic, subdiv, so, addr, phys = r
            excel_rows.append([i, ecs_no or "", name or "", desig or "", qual or "",
                            dob or "", doj or "", cpf or "", pan or "", mob or "",
                            pran or "", level or "", basic or 0,
                            subdiv or "", so or "", addr or "", (phys or "").upper()])

        stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        # try xlsx first
        try:
            from openpyxl import Workbook
            from openpyxl.styles import Font, Alignment
            xlsx_path = os.path.join(tempfile.gettempdir(), f"Staff_Details_{stamp}.xlsx")
            wb = Workbook(); ws = wb.active; ws.title = "Staff Details"
            ws.append(headers)
            for c in ws[1]:
                c.font = Font(bold=True); c.alignment = Alignment(horizontal="center")
            for r in excel_rows: ws.append(r)
            ws.freeze_panes = "A2"
            width_hints = [6,12,22,18,18,12,12,16,14,14,14,8,10,14,12,36,12]
            for i, w in enumerate(width_hints, start=1):
                try:
                    ws.column_dimensions[chr(64+i)].width = w
                except:
                    pass
            wb.save(xlsx_path)
            out = xlsx_path
        except Exception:
            # csv fallback
            csv_path = os.path.join(tempfile.gettempdir(), f"Staff_Details_{stamp}.csv")
            with open(csv_path, "w", newline="", encoding="utf-8-sig") as f:
                writer = csv.writer(f); writer.writerow(headers); writer.writerows(excel_rows)
            out = csv_path

        self._open_file(out)
        self._last_excel_path = out

